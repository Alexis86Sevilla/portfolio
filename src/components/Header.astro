<header
  class="w-full fixed top-0 left-0 right-0 bg-gray-900/70 backdrop-blur-xl z-50 border-b border-gray-800/50"
>
  <nav
    class="mx-auto px-2 py-4 md:py-6 flex flex-col md:flex-row justify-between items-center max-w-6xl gap-4 md:gap-0"
  >
    <a
      href="/"
      class="text-3xl font-bold tracking-tighter bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent"
    >
      &lt;/&gt; Alexis GM
    </a>
    <ul
      class="flex flex-wrap justify-center gap-4 md:gap-8 text-[12px] font-mono uppercase tracking-widest mt-2 md:mt-0"
    >
      <li>
        <a
          href="/"
          data-section="home"
          class="nav-link hover:text-blue-400 transition relative"
        >
          Inicio
        </a>
      </li>
      <li>
        <a
          href="/about"
          data-section="about"
          class="nav-link hover:text-blue-400 transition relative"
        >
          Sobre mí
        </a>
      </li>
      <li>
        <a
          href="/#proyectos"
          data-section="proyectos"
          class="nav-link hover:text-blue-400 transition relative"
        >
          Proyectos
        </a>
      </li>
      <li>
        <a
          href="/#skills"
          data-section="skills"
          class="nav-link hover:text-blue-400 transition relative"
        >
          Habilidades
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function initActiveNav() {
    const sections = ["home", "proyectos", "skills"];
    const navLinks = document.querySelectorAll(".nav-link");

    navLinks.forEach((link) => {
      link.classList.remove("text-blue-400");
      link.removeAttribute("aria-current");
    });

    if (window.location.pathname === "/about") {
      const aboutLink = document.querySelector('[data-section="about"]');
      if (aboutLink) {
        aboutLink.classList.add("text-blue-400");
        aboutLink.setAttribute("aria-current", "page");
      }
      return;
    }

    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -80% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const sectionId = entry.target.id || "home";

          navLinks.forEach((link) => {
            link.classList.remove("text-blue-400");
            link.removeAttribute("aria-current");
          });

          const activeLink = document.querySelector(
            `[data-section="${sectionId}"]`
          );
          if (activeLink) {
            activeLink.classList.add("text-blue-400");
            activeLink.setAttribute("aria-current", "page");
          }
        }
      });
    }, observerOptions);

    sections.forEach((sectionId) => {
      const element = document.getElementById(sectionId);
      if (element) {
        observer.observe(element);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initActiveNav);
  document.addEventListener("astro:page-load", initActiveNav);
</script>