---
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="home"
  class="py-20 pt-40 md:py-32 px-6 max-w-6xl mx-auto text-center md:text-left flex flex-col items-center md:items-start"
>
  <div
    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm mb-8"
  >
    <span class="relative flex h-2 w-2">
      <span
        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
      ></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"
      ></span>
    </span>
    Disponible para nuevos proyectos
  </div>

  <h1
    class="flex flex-col md:flex-row gap-0 md:gap-6 text-5xl md:text-7xl font-bold tracking-tighter mb-6"
  >
    <span
      class="bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 bg-clip-text text-transparent"
    >
      Desarrollador
    </span>
    <span>Frontend</span>
  </h1>

  <p class="text-lg md:text-xl text-gray-400 max-w-2xl mb-10 leading-relaxed">
    Especializado en Angular y orientado a producto, con base en Java y Spring
    Boot para el backend cuando el producto lo necesita. Construyo aplicaciones
    web prácticas, con código limpio y mantenible.
  </p>

  <div class="flex flex-col gap-8 md:gap-6 w-full md:w-auto">
    <div class="flex flex-wrap gap-4 w-full sm:w-auto">
      <a
        href="mailto:alegarman86@gmail.com"
        class="bg-blue-600 hover:bg-blue-500 hover:shadow-[0_0_20px_rgba(37,99,235,0.5)] text-white px-8 py-3 rounded-full font-medium transition-all duration-300 hover:scale-105 text-center"
        >Hablemos →</a
      >
      <a
        href="#proyectos"
        class="border border-white/10 hover:border-white/30 hover:bg-white/5 px-8 py-3 rounded-full font-medium transition-all duration-300 hover:scale-105 text-center"
        >Ver proyectos</a
      >
      <a
        href="/cv"
        class="border border-white/10 hover:border-white/30 hover:bg-white/5 px-8 py-3 rounded-full font-medium transition-all duration-300 hover:scale-105 text-center inline-flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          ><path
            d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
          ></path><polyline points="14 2 14 8 20 8"></polyline><line
            x1="8"
            y1="13"
            x2="16"
            y2="13"></line><line x1="8" y1="17" x2="16" y2="17"></line></svg
        >
        Ver CV</a
      >
    </div>
    <SocialLinks />
  </div>
</section>
