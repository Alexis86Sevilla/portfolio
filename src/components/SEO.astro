---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Alexis García | Desarrollador Web Full Stack",
  description = "Portafolio de un desarrollador web full stack especializado en construir aplicaciones prácticas, bien estructuradas y mantenibles.",
  image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alexis García",
  jobTitle: "Desarrollador Web Full Stack",
  url: Astro.site?.toString(),
  sameAs: [
    "https://github.com/Alexis86Sevilla",
    "https://www.linkedin.com/in/alexis-gm/",
  ],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Alexis García" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
