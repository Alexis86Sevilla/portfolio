---
import { ClientRouter } from "astro:transitions";
import BackgroundGlow from "../components/BackgroundGlow.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MouseGlow from "../components/MouseGlow.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="min-h-screen text-white relative flex flex-col print:text-[10.5pt] print:leading-[1.45]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-white print:hidden"
      >Saltar al contenido</a
    >
    <BackgroundGlow />
    <MouseGlow />
    <Header />
    <div class="relative z-10 grow">
      <main id="main">
        <slot />
      </main>
    </div>
    <div class="relative z-20">
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
